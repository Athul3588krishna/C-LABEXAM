#include <stdio.h>
#include <stdlib.h>

struct node{
    int data;
    struct node *next;
};

struct node *top=NULL;

void push(int x){
    struct node *n=malloc(sizeof(struct node));
    n->data=x;
    n->next=top;
    top=n;
}

void pop(){
    if(top==NULL) return;
    struct node *t=top;
    top=top->next;
    printf("Popped: %d\n",t->data);
    free(t);
}

void display(){
    struct node *t=top;
    while(t!=NULL){
        printf("%d ",t->data);
        t=t->next;
    }
}

int main(){
    int ch,x;
    while(1){
        printf("\n1.Push 2.Pop 3.Display 4.Exit\n");
        scanf("%d",&ch);
        switch(ch){
            case 1: scanf("%d",&x); push(x); break;
            case 2: pop(); break;
            case 3: display(); break;
            case 4: return 0;
        }
    }
}
